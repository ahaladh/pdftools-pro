# /etc/pdftools/pdftools.env  --  chmod 0640, owner root:pdftools. Never commit the real file.
# systemd EnvironmentFile syntax: KEY=value, no quotes needed, no `export`.
NODE_ENV=production
PORT=4000
STORAGE_DIR=/var/lib/pdftools
APP_VERSION=1.0.0
PUBLIC_URL=https://pdf.example.com
CORS_ORIGINS=https://pdf.example.com
TRUST_PROXY=1
DOWNLOAD_SECRET=            # openssl rand -hex 32
JWT_ACCESS_SECRET=          # openssl rand -hex 32
METRICS_TOKEN=              # openssl rand -hex 16 (enables /metrics for Prometheus on the internal port)
MONGODB_URI=mongodb://pdftools:CHANGE_ME@127.0.0.1:27017/pdftools?authSource=admin
QUEUE_DRIVER=bullmq
REDIS_URL=redis://127.0.0.1:6379
SMTP_URL=
MAIL_FROM=PDFTools <no-reply@example.com>
# First start only, then delete these two lines:
ADMIN_EMAIL=
ADMIN_PASSWORD=
