{
  "name": "@pdftools/api",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:db": "node scripts-dev-mongo.mjs",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "node dist/migrate.js",
    "doctor": "node dist/doctor.js"
  },
  "dependencies": {
    "@pdftools/pdf-core": "*",
    "@pdftools/shared": "*",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "fflate": "^0.8.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.0",
    "mongoose": "^8.8.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.16",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "stripe": "^17.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
