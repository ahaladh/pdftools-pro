# Copy to .env. Never commit real secrets.
NODE_ENV=development
PORT=4000
BRAND_NAME=PDFTools Pro

# Comma-separated browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (1 behind nginx) so rate limiting sees real client IPs.
TRUST_PROXY=0

# REQUIRED in production: >=32 random chars. Generate with: openssl rand -hex 32
DOWNLOAD_SECRET=
DOWNLOAD_LINK_TTL_SECONDS=600

# Private storage root (must not be web-served).
STORAGE_DIR=./data

# Guest limits (override per deployment; admin-configurable limits arrive with the admin phase).
MAX_FILE_MB=50
MAX_FILES=20
MAX_PAGES=500
MAX_CONCURRENT_JOBS_PER_USER=2
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=120
RETENTION_MINUTES=60
CLEANUP_INTERVAL_SECONDS=60

RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX_PER_WINDOW=60
MAINTENANCE_MODE=false
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
APP_VERSION=dev
# Bearer token for Prometheus. In production /metrics is DISABLED unless this is set. (openssl rand -hex 16)
METRICS_TOKEN=
# On SIGTERM: report "draining" for N seconds (load balancer stops routing), then wait up to GRACE for in-flight work.
# Keep your orchestrator's stop timeout above the sum (compose/systemd use 45 s).
SHUTDOWN_DRAIN_SECONDS=5
SHUTDOWN_GRACE_SECONDS=30
# Worker health/metrics port (0 = off). Internal interface only. compose sets 9100; systemd uses 9101, 9102...
WORKER_HEALTH_PORT=0
# auto = run pending DB migrations at API start (lock-protected); check = refuse to start if any are pending; off = never.
MIGRATIONS=auto

# ---------------------------------------------------------------------------
# docker-compose + Caddy (docker-compose.tls.yml)
# ---------------------------------------------------------------------------
# Public origin of the site, baked into canonical URLs/sitemap at build time. REQUIRED for the web image build.
SITE_ADDRESS=pdf.example.com
SITE_URL=https://pdf.example.com
ACME_EMAIL=ops@example.com
# Leave empty in production. TLS_DIRECTIVE="tls internal" = self-signed, for a local trial only.
TLS_DIRECTIVE=

# ---------------------------------------------------------------------------
# Job execution and resource limits
# ---------------------------------------------------------------------------
# inline  = jobs run inside the API process (simplest; fine for one small instance)
# bullmq  = API only enqueues to Redis; run one or more separate workers (`node apps/api/dist/worker.js`).
#           Requires REDIS_URL and MONGODB_URI, and the API and workers must share STORAGE_DIR (same volume).
QUEUE_DRIVER=inline
REDIS_URL=
# Every job runs in its own process under kernel limits. Leave on.
ISOLATE_JOBS=true
# Address-space cap for the whole job process (min 1536; engine caps below are clamped to it).
ISOLATION_MEMORY_MB=4096
ENGINE_MEMORY_MB=2048
ENGINE_OFFICE_MEMORY_MB=4096
# Optional engines. Leave unset if installed system-wide (tesseract on PATH). VERAPDF_BIN enables PDF/A validation of every result;
# without it PDF/A output is labelled "not independently validated". See docs/DEPLOYMENT.md.
# PDFTOOLS_BIN_DIR=/opt/tools/bin
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
# VERAPDF_BIN=/opt/verapdf/verapdf
ENGINE_CPU_SECONDS=120
ENGINE_MAX_FILE_MB=1024
# A job whose runner stops heartbeating this long is failed as lost; a job nobody picked up is failed after the queue timeout.
HEARTBEAT_STALE_SECONDS=30
QUEUE_TIMEOUT_SECONDS=900
# Refuse new jobs when stored data exceeds this many MB (0 = unlimited).
MAX_STORAGE_MB=0
STORAGE_CACHE_SECONDS=10
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Accounts, billing, admin. Leave MONGODB_URI empty to run guest-only (no sign-in, no admin).
# ---------------------------------------------------------------------------
MONGODB_URI=
# REQUIRED in production when MONGODB_URI is set: >=32 random chars (openssl rand -hex 32).
JWT_ACCESS_SECRET=
# Encrypts two-factor secrets at rest (32+ chars: openssl rand -hex 32). Set it separately from the JWT secret: rotating
# JWT_ACCESS_SECRET must not lock 2FA users out. Do NOT change it later without a migration plan: stored secrets become unreadable.
TWO_FACTOR_KEY=
# Require a confirmed email address before a paid checkout (recommended in production).
REQUIRE_VERIFIED_EMAIL=false
# Teams: seats per paid team plan (members plus pending invitations); an unpaid team has one seat. Invitations expire after N days.
TEAM_SEATS_PRO=3
TEAM_SEATS_BUSINESS=10
TEAM_INVITE_TTL_DAYS=7
VERIFY_TOKEN_TTL_HOURS=24
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Public origin of the site (links in emails, Stripe redirects).
PUBLIC_URL=http://localhost:5173
# Password-reset email. Without SMTP_URL, dev prints the link to the log; production sends nothing.
SMTP_URL=
MAIL_FROM=PDFTools Pro <no-reply@example.com>
# Optional first admin, created at startup if the email does not exist. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Stripe (leave empty to disable billing; nothing is simulated). Price ids can also be set in the admin UI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Baseline entitlements (admins can override at runtime).
DAILY_OPS_GUEST=30
DAILY_OPS_FREE=60
PREMIUM_TOOLS=office-to-pdf,redact,compare
# docker-compose only: credentials for the bundled MongoDB.
MONGO_USER=pdftools
MONGO_PASSWORD=change-me-please

# Web build-time: VITE_BRAND_NAME is public (never put secrets in VITE_* variables). SITE_URL (above) sets the public origin
# everywhere: canonical URLs, sitemap, robots.txt and prerendered pages.
VITE_BRAND_NAME=PDFTools Pro
